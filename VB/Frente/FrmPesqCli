Private Sub Form_Load()

DatDados.DatabaseName = FrmFrente.Caminho & "\Dados.mdb"
DatDados.RecordSource = "Select Ent.CodEntidade,Ent.Nome,Ent.Endereco, Ent.Nro, Ent.Cidade, Ent.Fone, Ent.Fax, Ent.Celular From Ent WHERE Ent.Ativo = True and (Ent.Tipo = 1 or Ent.Tipo >= 5) Order By Ent.Nome"
DatDados.Refresh

End Sub

