Private Sub CmbBotao_Click(Index As Integer)
If Index = 0 Then
    If FrmFrente.LblPedido = "" Then
        FrmFrente.TxtDados(0) = DatDados.Recordset.Fields(0)
    Else
        FrmFrente.DbcCliente = DatDados.Recordset.Fields(1)
    End If
    Unload Me
'     If FrmFrente.MebTotal <> "" Then
'        FrmFrente.DbcCliente.SetFocus
'    End If
Else
    Unload Me
    If FrmFrente.MebTotal <> "" Then
        FrmFrente.DbcCliente.SetFocus
    End If
End If
End Sub

Private Sub DatDados_Reposition()
On Error GoTo erro
With DatDados.Recordset
    TxtEnd = .Fields("Endereco")
    TxtNro = .Fields("Nro")
    TxtFone = Format(.Fields("Fone"), "(@@)@@@@-@@@@")
    TxtFax = Format(.Fields("Fax"), "(@@)@@@@-@@@@")
    TxtCelular = Format(.Fields("Celular"), "(@@)@@@@-@@@@")
End With

Exit Sub

erro:

'    MsgBox "Campo nulo ou inválido - " & Err.Description & Err.Number, vbInformation, App.Title

End Sub

Private Sub DBGProdutos_KeyPress(KeyAscii As Integer)
