Private Sub Form_Load()
Dim SomaProd As Double
Dim SomaMedia As Double
Dim Cont As Double
Dim Componentes As Variant
Dim SQL As String

For Each Componentes In DatDados
    Componentes.DatabaseName = Caminho & "\Dados.mdb"
Next
SQL = "SELECT GRU.Descrição_Grupo, CStr([Grupo]) AS Expr1, Count(PRD.Grupo) AS SomaGrupo, Avg(PRD.Margem) AS MédiaMargem FROM GRU INNER JOIN PRD ON GRU.CodGru = PRD.Grupo GROUP BY GRU.Descrição_Grupo, CStr([Grupo]) ORDER BY Count(PRD.Grupo)"
' Sql = "SELECT GRU.Descrição_Grupo, CStr([Grupo]) AS Expr1, Count(PRD.Grupo) AS SomaGrupo, Avg(PRD.Margem) AS MédiaMargem, Sum(PRD.Estoque) AS SomaDeEstoque FROM GRU INNER JOIN PRD ON GRU.CodGru = PRD.Grupo GROUP BY GRU.Descrição_Grupo, CStr([Grupo]) HAVING (((Sum(PRD.Estoque))<>0)) ORDER BY Count(PRD.Grupo)"

DatDados(0).RecordSource = SQL
DatDados(0).Refresh

Cont = 0
DatDados(0).Recordset.MoveFirst
Do Until DatDados(0).Recordset.Eof
    If GetInputState() Then DoEvents

    Cont = Cont + 1
    SomaProd = SomaProd + DatDados(0).Recordset.Fields("SomaGrupo")
    SomaMedia = SomaMedia + DatDados(0).Recordset.Fields("MédiaMargem")
    DatDados(0).Recordset.MoveNext
Loop

TxtProd = Format(SomaProd, "##,###,###")
TxtMargem = Format(SomaMedia / Cont, "###,###.##")

End Sub

Private Sub Opt_Click(Index As Integer)
If Index = 0 Then
    SQL = "SELECT GRU.Descrição_Grupo, CStr([Grupo]) AS Expr1, Count(PRD.Grupo) AS SomaGrupo, Avg(PRD.Margem) AS MédiaMargem, Sum(PRD.Estoque) AS SomaDeEstoque FROM GRU INNER JOIN PRD ON GRU.CodGru = PRD.Grupo GROUP BY GRU.Descrição_Grupo, CStr([Grupo]) HAVING (((Sum(PRD.Estoque))<>0)) ORDER BY Count(PRD.Grupo)"
Else
    SQL = "SELECT GRU.Descrição_Grupo, CStr([Grupo]) AS Expr1, Count(PRD.Grupo) AS SomaGrupo, Avg(PRD.Margem) AS MédiaMargem, Sum(PRD.Estoque) AS SomaDeEstoque FROM GRU INNER JOIN PRD ON GRU.CodGru = PRD.Grupo GROUP BY GRU.Descrição_Grupo, CStr([Grupo]) HAVING (((Sum(PRD.Estoque))<>0)) ORDER BY Avg(PRD.Margem)"
End If
DatDados(0).RecordSource = SQL
DatDados(0).Refresh
End Sub
