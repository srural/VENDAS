# ==============================================================================
# MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# ==============================================================================

# AMBIENTE DA APLICAÇÃO (development | testing | production)
APP_ENV=development
DEBUG=False
SECRET_KEY=sua_chave_secreta_aqui_gerada_aleatoriamente

# SERVIDOR WEB (Flask / Waitress WSGI)
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SERVER_THREADS=8
OPEN_BROWSER_ON_START=True

# BANCO DE DADOS (PostgreSQL)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=sua_senha_do_banco
PG_DB=vendas_db

# SEFAZ (1 = Produção, 2 = Homologação / Teste)
SEFAZ_AMBIENTE=2

# NF-e (Modelo 55)
NFE_SERIE=1
NFE_NUMERO_INICIAL=1

# NFC-e (Modelo 65 - PDV)
NFCE_SERIE=1
NFCE_NUMERO_INICIAL=1
NFCE_CSC_ID=000001
NFCE_CSC_TOKEN=seu_csc_token_aqui

# Certificado Digital A1
CERTIFICADO_PATH=C:\Certificados\certificado.pfx
CERTIFICADO_SENHA=senha_do_certificado
CERTIFICADO_CNPJ=00000000000000
